CREATE DATABASE IF NOT EXISTS university_db;
USE university_db;

CREATE TABLE groups (
    group_id INT PRIMARY KEY AUTO_INCREMENT,
    group_name VARCHAR(50) NOT NULL UNIQUE,
    specialization VARCHAR(100),
    year_of_admission YEAR NOT NULL
);

CREATE TABLE students (
    student_id INT PRIMARY KEY AUTO_INCREMENT,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    patronymic VARCHAR(50),
    date_of_birth DATE NOT NULL,
    email VARCHAR(100) UNIQUE,
    phone_number VARCHAR(20),
    address VARCHAR(200),
    group_id INT NOT NULL,
    enrollment_year YEAR NOT NULL,
    FOREIGN KEY (group_id) REFERENCES groups(group_id),
    INDEX idx_students_group_id (group_id)
);
CREATE TABLE teachers (
    teacher_id INT PRIMARY KEY AUTO_INCREMENT,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    patronymic VARCHAR(50),
    date_of_birth DATE NOT NULL,
    email VARCHAR(100) UNIQUE,
    phone_number VARCHAR(20),
    office_number VARCHAR(20),
    academic_degree VARCHAR(100),
    hire_date DATE NOT NULL,
    UNIQUE KEY unique_teacher_fio (first_name, last_name, patronymic)
);
CREATE TABLE subject_categories (
    category_id INT PRIMARY KEY AUTO_INCREMENT,
    category_name VARCHAR(50) NOT NULL UNIQUE,
    category_type ENUM('Mathematical', 'Humanitarian', 'Technical', 'Physical') NOT NULL
);
CREATE TABLE subjects (
    subject_id INT PRIMARY KEY AUTO_INCREMENT,
    subject_name VARCHAR(100) NOT NULL,
    category_id INT NOT NULL,
    hours INT NOT NULL,
    FOREIGN KEY (category_id) REFERENCES subject_categories(category_id),
    UNIQUE KEY unique_subject (subject_name),
    INDEX idx_category (category_id)
    );
CREATE TABLE teaching (
    teaching_id INT PRIMARY KEY AUTO_INCREMENT,
    teacher_id INT NOT NULL,
    subject_id INT NOT NULL,
    group_id INT NOT NULL,
    academic_year INT NOT NULL,
    semester INT NOT NULL CHECK (semester BETWEEN 1 AND 2),
    FOREIGN KEY (teacher_id) REFERENCES teachers(teacher_id) ON DELETE RESTRICT,
    FOREIGN KEY (subject_id) REFERENCES subjects(subject_id) ON DELETE RESTRICT,
    FOREIGN KEY (group_id) REFERENCES groups(group_id) ON DELETE CASCADE,
    UNIQUE KEY unique_teaching (teacher_id, subject_id, group_id, academic_year, semester),
    INDEX idx_teacher (teacher_id),
    INDEX idx_subject (subject_id),
    INDEX idx_group (group_id)
);
CREATE TABLE grades (
    grade_id INT PRIMARY KEY AUTO_INCREMENT,
    student_id INT NOT NULL,
    teaching_id INT NOT NULL,
    grade INT NOT NULL CHECK (grade BETWEEN 1 AND 5),
    exam_date DATE NOT NULL,
    FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
    FOREIGN KEY (teaching_id) REFERENCES teaching(teaching_id) ON DELETE CASCADE,
    UNIQUE KEY unique_grade (student_id, teaching_id),
    INDEX idx_student (student_id),
    INDEX idx_teaching (teaching_id),
    INDEX idx_exam_date (exam_date)
);
